include SECURITY.md
# What setuptools leaves out of the sdist and the tests read: the CI workflow
# and the action's two files (the tests parse action.yml and run run_action.py).
# Every module under tests/ goes in -- fixture.py is imported by most of them --
# so an unpacked sdist runs its own tests.
include .github/workflows/ci.yml
include .github/workflows/release.yml
include CHANGELOG.md
include action.yml
include run_action.py
recursive-include tests *.py
